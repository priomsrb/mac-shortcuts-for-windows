<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MacShortcuts</AssemblyName>
    <RootNamespace>MacShortcuts</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Common Controls v6 (visual styles, ListView groups) and per-monitor DPI awareness. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>Mac Shortcuts for Windows</Product>
  </PropertyGroup>

  <!-- Native AOT: a single native exe with no .NET runtime dependency. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MacShortcuts.Tests" />
  </ItemGroup>

</Project>
